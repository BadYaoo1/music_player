# ========== 个人数据 / 缓存（绝不进 git）==========
# 歌词缓存 —— 包含你搜过的歌名，属个人隐私
lyrics/
lyrics.json
# 运行时设置 / cookie —— 含 B 站登录态和本机用户名
.properties
!pom.xml
!settings.xml
# 调试日志 —— 可能含堆栈、路径、cookie 片段
*.log
hs_err_pid*.log
*_fetch_test.ps1
_fetch_test.ps1

# ========== nodetest（开发时临时目录）==========
nodetest/*.class
nodetest/node.exe
# .js 探针脚本可以保留，也想丢弃就解注
